generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id         Int       @id @default(autoincrement())
  name       String
  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])

  costPrice     Int @default(0)
  sellingPrice  Int
  stockQty      Int @default(0)
  lowStockLevel Int @default(5)
  isActive      Boolean @default(true)

  saleItems  SaleItem[]
  orderItems OrderItem[]
  movements  StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([categoryId])
}

model Sale {
  id           Int    @id @default(autoincrement())
  totalAmount  Int
  cashReceived Int
  changeAmount Int
  status       String @default("COMPLETED")
  source       String @default("POS")

  items SaleItem[]
  order Order?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
  @@index([source])
  @@index([createdAt, status])
}

model SaleItem {
  id        Int @id @default(autoincrement())
  saleId    Int
  productId Int

  productName String
  quantity    Int
  unitPrice   Int
  costPrice   Int
  subtotal    Int
  profit      Int

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model StockMovement {
  id        Int @id @default(autoincrement())
  productId Int

  type     String
  quantity Int
  note     String?

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model Order {
  id            Int         @id @default(autoincrement())
  customerName  String
  phone         String
  address       String
  totalAmount   Int
  paymentStatus String      @default("UNPAID")
  status        String      @default("PENDING")
  orderDate     DateTime    @default(now())
  notes         String?
  saleId        Int?        @unique
  sale          Sale?       @relation(fields: [saleId], references: [id])
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([paymentStatus])
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  productId   Int?
  productName String
  unitPrice   Int
  quantity    Int
  subtotal    Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String

  updatedAt DateTime @updatedAt
}
