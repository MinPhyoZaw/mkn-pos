{
  "name": "toy-stationery-pos",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"next dev\" \"wait-on tcp:3000 && electron .\"",
    "build": "next build",
    "start": "next start",
    "electron": "electron .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "prisma": "^6.0.0",
    "typescript": "^5.7.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.rds.toystationerypos",
    "productName": "Toy & Stationery POS",
    "files": [
      "electron/**/*",
      ".next/**/*",
      "out/**/*",
      "public/**/*",
      "package.json",
      "node_modules/**/*",
      "prisma/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}