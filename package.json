{
  "name": "toy-stationery-pos",
  "version": "1.0.0",
  "private": true,
  "description": "Offline POS system for Daw Jar Nu Toys and Stationery Shop",
  "author": "Rangoon Digital Solution",
  "main": "electron/main.cjs",

  "scripts": {
    "dev": "concurrently \"next dev -p 3000\" \"wait-on tcp:3000 && electron .\"",
    "build": "next build",
    "start": "next start",
    "electron": "electron .",

    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",

    "dist": "npm run prisma:generate && npm run build && electron-builder",
    "dist:win": "npm run prisma:generate && npm run build && electron-builder --win"
  },

  "dependencies": {
    "@prisma/client": "^6.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1"
  },

  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "prisma": "^6.0.0",
    "typescript": "^5.7.0",
    "wait-on": "^8.0.0"
  },

 "build": {
  "appId": "com.rds.dawjarnutoysandstationerypos",
  "productName": "Daw Jar Nu Toys and Stationery POS",

  "directories": {
    "output": "dist"
  },

  "files": [
    "electron/**/*",
    "out/**/*",
    "public/**/*",
    "prisma/**/*",
    "build/icon.ico",
    "package.json",
    "node_modules/**/*"
  ],

  "asar": false,

  "extraResources": [
    {
      "from": "node_modules/.prisma",
      "to": "app/node_modules/.prisma",
      "filter": [
        "**/*"
      ]
    }
  ],

  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },

  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Daw Jar Nu POS",
    "uninstallDisplayName": "Daw Jar Nu POS"
  }
}
}